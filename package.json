{
  "name": "playwright-domain-driven-testing-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "vite app --config app/vite.config.ts",
    "build": "vite build app --config app/vite.config.ts",
    "preview": "vite preview app --config app/vite.config.ts --host 0.0.0.0 --port 5500 --strictPort",
    "manifest:serve": "pnpm dlx http-server -p 6002 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit/*.spec.ts",
    "test:e2e:chromium": "pnpm build && vitest run $(find tests -type f -path '*/business/*.spec.ts')",
    "test:e2e:headed": "HEADED=1 pnpm test:e2e:chromium",
    "test:e2e:debug": "HEADED=1 PWDEBUG=1 pnpm test:e2e:chromium",
    "test:e2e:slow": "HEADED=1 SLOWMO=1000 pnpm test:e2e:chromium",
    "test:e2e:openfin": "pnpm build && node scripts/run-openfin-tests.mjs $(find tests -type f -path '*/business/*.spec.ts')",
    "test:validate": "pnpm test:unit && if [ -n \"$OPENFIN_CDP_URL\" ]; then pnpm test:e2e:openfin && pnpm test:e2e:chromium; else pnpm test:e2e:chromium; fi",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "2.1.9",
    "husky": "^9.0.11",
    "playwright": "^1.49.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vite": "^6.4.2",
    "vitest": "^2.1.9"
  }
}
