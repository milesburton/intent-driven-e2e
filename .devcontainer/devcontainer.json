{
  "name": "Playwright Domain-Driven Testing Example",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-playwright.playwright",
        "anthropic.claude-code", // Claude Code for VS Code
        "continue.continue", // Continue open-source AI agent
        "ms-vscode-remote.remote-containers" // Dev Containers support
      ],
      "settings": {
        "terminal.integrated.profiles.linux": {
          "bash": { "path": "/bin/bash" },
          "fish": { "path": "/usr/bin/fish" }
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        // Increase file watcher limits for large projects/dev containers
        "files.watcherExclude": {
          "**/.git/objects/**": true,
          "**/node_modules/**": true
        },
        "files.maxMemoryForLargeFilesMB": 4096,
        "files.autoSave": "onWindowChange"
      }
    }
  },
  "runArgs": ["--shm-size=1gb"],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
    "XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
    "PULSE_SERVER": "${localEnv:PULSE_SERVER}"
  },
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
    "source=/mnt/wslg,target=/mnt/wslg,type=bind,consistency=cached"
  ],
  "forwardPorts": [6000],
  "postCreateCommand": "corepack prepare pnpm@9.0.0 --activate && pnpm install"
}
