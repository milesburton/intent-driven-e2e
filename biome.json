{
  "$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "includes": ["app/src/**", "tests/**", "*.ts", "*.js", "*.json"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "nursery": {}
    },
    "includes": ["app/src/**", "tests/**", "*.ts", "*.js", "*.json"]
  }
}
