# Enforce LF line endings across the repository
# Normalizes text files in the index to LF and checks out with LF
* text=auto eol=lf

# Common binary files (no line ending normalization)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.bz2 binary
*.xz binary